{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev (custom server)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-server.js"],
      "port": 3000
    },
    {
      "name": "Next.js Dev (clean cache)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-server.js"],
      "env": { "DEV_CLEAR_CACHE": "1" },
      "port": 3000
    },
    {
      "name": "Next.js Dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev"],
      "port": 3000
    },
    {
      "name": "Next.js Dev (port 3100)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "Next.js Dev (Turbo)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--turbo"],
      "port": 3000
    }
  ]
}
