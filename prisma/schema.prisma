// Prisma schema for MySQL on SiteGround
// DATABASE_URL should be a MySQL connection string (e.g., mysql://user:pass@host:3306/db)
// USE_DB should be set to "true" in environment variables

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Wiki {
  slug              String   @id
  displayName       String
  grade             String?
  picture           String?  @db.Text
  isPublished       Boolean  @default(true)
  domains           Json?
  tags              Json?
  defaultLocale     String?  @default("en")
  defaultLessonSlug String?  @default("getting-started")
  resourcesUrl      String?  @default("/resources")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([slug])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lesson {
  id               String   @id
  lessonKey        String
  order            Int
  slug             String
  wikiSlug         String
  title_en         String
  title_ar         String
  coverImage       String?
  ownerId          String?
  lastModifiedBy   String?
  status           String   @default("draft")
  publishedAt      DateTime?
  duration_min     Int
  difficulty       String
  prerequisites_en Json
  prerequisites_ar Json
  materials        Json
  body             Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Document Locking & Versioning
  version          Int      @default(1)
  activeEditorId   String?
  lockedUntil      DateTime?

  @@index([wikiSlug])
  @@index([wikiSlug, lessonKey])
  @@index([wikiSlug, slug, status, version])
  @@index([wikiSlug, lessonKey, status, version])
}

model Developer {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  name       String?
  role       String?
  avatarUrl  String?  @db.Text
  wikiSlugs  Json?
  lessonIds  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Asset {
  id        Int      @id @default(autoincrement())
  wikiSlug  String?
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([wikiSlug])
}

model AccessCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  wikiSlug  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wikiSlug])
}

// --- Teacher/student access system ---

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  avatarUrl     String?  @db.Text
  role               String    // "admin" | "teacher" | "student"
  assignedWikiSlugs  Json?     // string[] — only used for teachers
  disabledAt         DateTime?
  createdByName      String?   // display name of the admin who created this account
  createdByEmail     String?   // email of the admin who created this account
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  teacherLinks      EnrollmentLink[] @relation("TeacherLinks")
  teacherEnrollments Enrollment[]    @relation("TeacherEnrollments")
  studentEnrollments Enrollment[]    @relation("StudentEnrollments")
  progress          LessonProgress[]
  trackAssignments  TrackAssignment[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

model EnrollmentLink {
  id          String    @id @default(cuid())
  token       String    @unique
  teacherId   String
  wikiSlug    String
  name        String?   // teacher-chosen class name; null → UI shows "Class N"
  isActive    Boolean   @default(true)
  // Optional schedule. Access is computed from these on read (no cron job):
  // the class is open when isActive AND now is within [startsAt, endsAt].
  // endsAt is stored at end-of-day so the class runs through that date.
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  disabledAt  DateTime?

  teacher     User         @relation("TeacherLinks", fields: [teacherId], references: [id])
  enrollments Enrollment[]

  // Each link is a "class". A teacher may run several active classes per wiki,
  // so there is no longer a one-active-link-per-(teacher, wiki) constraint.
  @@index([teacherId, wikiSlug])
  @@index([token])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  teacherId  String
  linkId     String
  wikiSlug   String
  status     String   @default("active") // "active" | "removed" | "revoked"
  joinedAt   DateTime @default(now())
  removedAt  DateTime?

  student User           @relation("StudentEnrollments", fields: [studentId], references: [id])
  teacher User           @relation("TeacherEnrollments", fields: [teacherId], references: [id])
  link    EnrollmentLink @relation(fields: [linkId], references: [id])

  @@unique([studentId, wikiSlug, linkId])
  @@index([teacherId, status])
  @@index([studentId, status])
  @@index([linkId])
  @@index([wikiSlug])
}

model LessonProgress {
  id           String    @id @default(cuid())
  studentId    String
  wikiSlug     String
  lessonId     String
  status       String    @default("in_progress") // "in_progress" | "completed"
  // Active time on the lesson, in seconds. Only counted while the tab is
  // visible, focused and not idle — see app/components/LessonProgressTracker.
  timeSpentSec Int       @default(0)
  lastViewedAt DateTime  @default(now())
  completedAt  DateTime?

  student User @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
  @@index([studentId, wikiSlug])
  @@index([lessonId])
}

model Track {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  createdByUserId  String?
  createdByType    String   // "teacher" | "admin" | "developer"
  createdByName    String?
  createdByEmail   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wikis       TrackWiki[]
  assignments TrackAssignment[]
  inviteLinks TrackInviteLink[]

  @@index([createdByUserId])
  @@index([createdByType])
}

model TrackWiki {
  id       String @id @default(cuid())
  trackId  String
  wikiSlug String
  position Int    @default(0)

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, wikiSlug])
  @@index([trackId, position])
  @@index([wikiSlug])
}

model TrackAssignment {
  id               String   @id @default(cuid())
  trackId          String
  studentId        String
  assignedByUserId String?
  linkId           String?
  assignedAt       DateTime @default(now())

  track   Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  link    TrackInviteLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@unique([trackId, studentId])
  @@index([studentId])
  @@index([linkId])
}

model TrackInviteLink {
  id              String    @id @default(cuid())
  token           String    @unique
  trackId         String
  createdByActorId String
  createdByUserId String?
  createdByName   String?
  createdByEmail  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  disabledAt      DateTime?

  track       Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  assignments TrackAssignment[]

  @@index([trackId, createdByActorId])
  @@index([token])
}
